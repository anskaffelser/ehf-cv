<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns="urn:fdc:anskaffelser.no:2019:ehf:schema:CVRequest-1"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    targetNamespace="urn:fdc:anskaffelser.no:2019:ehf:schema:CVRequest-1"
    elementFormDefault="qualified"
    version="1.0">

    <xs:element name="CVRequest" type="CVRequestType"/>

    <xs:complexType name="CVRequestType">
        <xs:sequence>
            <xs:element name="CustomizationID" type="IdentifierType"/>
            <xs:element name="ProfileID" type="IdentifierType"/>
            <xs:element name="ID" type="IdentifierType"/>
            <xs:element name="RoleDescription" type="TextType"/>
            <xs:element name="IssueDate" type="DateType"/>
            <xs:element name="IssueTime" type="TimeType" minOccurs="0"/>
            <xs:element name="SenderParty" type="SenderPartyType"/>
            <xs:element name="ReceiverParty" type="ReceiverPartyType"/>
            <xs:element name="PoliceCertificate" type="PoliceCertificateType" minOccurs="0"/>
            <xs:element name="Education" type="EducationType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="Course" type="CourseType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="Certification" type="CertificationType" minOccurs="0"
                maxOccurs="unbounded"/>
            <xs:element name="LanguageSkills" type="LanguageSkillsType" minOccurs="0"
                maxOccurs="unbounded"/>
            <xs:element name="ProjectExperience" type="ProjectExperienceType" minOccurs="0"
                maxOccurs="unbounded"/>
            <xs:element name="WorkExperience" type="WorkExperienceType" minOccurs="0"
                maxOccurs="unbounded"/>
            <xs:element name="Skills" type="SkillsType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="Clearance" type="ClearanceType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Aggregerte typer -->

    <xs:complexType name="PoliceCertificateType">
        <xs:sequence>
            <xs:element name="ID" type="IdentifierType"/>
            <xs:element name="Requirement" type="CodeType" minOccurs="0"/>
            <xs:element name="Type" type="CodeType" minOccurs="0"/>
            <xs:element name="ValidTo" type="DateType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="EducationType">
        <xs:sequence>
            <xs:element name="ID" type="IdentifierType"/>
            <xs:element name="Requirement" type="CodeType" minOccurs="0"/>
            <xs:element name="Title" type="TextType" minOccurs="0"/>
            <xs:element name="EducationDegree" type="CodeType" minOccurs="0"/>
            <xs:element name="RelevantExperience" type="RelevantExperienceType" minOccurs="0"/>
            <xs:element name="AlternativeEducation" type="AlternativeEducationType" minOccurs="0"
                maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="AlternativeEducationType">
        <xs:sequence>
            <xs:element name="ID" type="IdentifierType"/>
            <xs:element name="Requirement" type="CodeType" minOccurs="0"/>
            <xs:element name="Title" type="TextType" minOccurs="0"/>
            <xs:element name="EducationDegree" type="CodeType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CourseType">
        <xs:sequence>
            <xs:element name="ID" type="IdentifierType"/>
            <xs:element name="Requirement" type="CodeType" minOccurs="0"/>
            <xs:element name="Title" type="TextType" minOccurs="0"/>
            <xs:element name="VersionID" type="IdentifierType" minOccurs="0"/>
            <xs:element name="Period" type="PeriodType" minOccurs="0"/>
            <xs:element name="AlternativeCourse" type="AlternativeCourseType" minOccurs="0"
                maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="AlternativeCourseType">
        <xs:sequence>
            <xs:element name="ID" type="IdentifierType"/>
            <xs:element name="Requirement" type="CodeType" minOccurs="0"/>
            <xs:element name="Title" type="TextType" minOccurs="0"/>
            <xs:element name="VersionID" type="IdentifierType" minOccurs="0"/>
            <xs:element name="Period" type="PeriodType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CertificationType">
        <xs:sequence>
            <xs:element name="ID" type="IdentifierType"/>
            <xs:element name="Requirement" type="CodeType" minOccurs="0"/>
            <xs:element name="Title" type="TextType" minOccurs="0"/>
            <xs:element name="VersionID" type="IdentifierType" minOccurs="0"/>
            <xs:element name="ValidTo" type="DateType" minOccurs="0"/>
            <xs:element name="AlternativeCertification" type="AlternativeCertificationType"
                minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="AlternativeCertificationType">
        <xs:sequence>
            <xs:element name="ID" type="IdentifierType"/>
            <xs:element name="Requirement" type="CodeType" minOccurs="0"/>
            <xs:element name="Title" type="TextType" minOccurs="0"/>
            <xs:element name="VersionID" type="IdentifierType" minOccurs="0"/>
            <xs:element name="ValidTo" type="DateType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="LanguageSkillsType">
        <xs:sequence>
            <xs:element name="ID" type="IdentifierType"/>
            <xs:element name="Requirement" type="CodeType" minOccurs="0"/>
            <xs:element name="Language" type="CodeType" minOccurs="0"/>
            <xs:element name="Scandinavian" type="xs:boolean" minOccurs="0"/>
            <xs:element name="OralSkill" type="CodeType" minOccurs="0"/>
            <xs:element name="WrittenSkill" type="CodeType" minOccurs="0"/>
            <xs:element name="AlternativeLanguageSkill" type="AlternativeLanguageSkillType"
                minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="AlternativeLanguageSkillType">
        <xs:sequence>
            <xs:element name="ID" type="IdentifierType"/>
            <xs:element name="Requirement" type="CodeType" minOccurs="0"/>
            <xs:element name="Language" type="CodeType" minOccurs="0"/>
            <xs:element name="Scandinavian" type="xs:boolean" minOccurs="0"/>
            <xs:element name="OralSkill" type="CodeType" minOccurs="0"/>
            <xs:element name="WrittenSkill" type="CodeType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ProjectExperienceType">
        <xs:sequence>
            <xs:element name="ID" type="IdentifierType"/>
            <xs:element name="Requirement" type="CodeType" minOccurs="0"/>
            <xs:element name="ExperienceType" type="CodeType" minOccurs="0"/>
            <xs:element name="IndustryType" type="CodeType" minOccurs="0"/>
            <xs:element name="Workplace" type="CodeType" minOccurs="0"/>
            <xs:element name="JobSector" type="CodeType" minOccurs="0"/>
            <xs:element name="RequiredTotalExperience" type="RequiredTotalExperienceType"
                minOccurs="0"/>
            <xs:element name="Period" type="PeriodType" minOccurs="0"/>
            <xs:element name="ExperienceDescription" type="ExperienceDescriptionType" minOccurs="0"/>
            <xs:element name="ExperienceValue" type="ExperienceValueType" minOccurs="0"/>
            <xs:element name="AlternativeProjectExperience" type="AlternativeProjectExperienceType"
                minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="AlternativeProjectExperienceType">
        <xs:sequence>
            <xs:element name="ID" type="IdentifierType"/>
            <xs:element name="Requirement" type="CodeType" minOccurs="0"/>
            <xs:element name="ExperienceType" type="CodeType" minOccurs="0"/>
            <xs:element name="IndustryType" type="CodeType" minOccurs="0"/>
            <xs:element name="Workplace" type="CodeType" minOccurs="0"/>
            <xs:element name="JobSector" type="CodeType" minOccurs="0"/>
            <xs:element name="RequiredTotalExperience" type="RequiredTotalExperienceType"
                minOccurs="0"/>
            <xs:element name="Period" type="PeriodType" minOccurs="0"/>
            <xs:element name="ExperienceDescription" type="ExperienceDescriptionType" minOccurs="0"/>
            <xs:element name="ExperienceValue" type="ExperienceValueType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="WorkExperienceType">
        <xs:sequence>
            <xs:element name="ID" type="IdentifierType"/>
            <xs:element name="Requirement" type="CodeType" minOccurs="0"/>
            <xs:element name="PositionLevel" type="CodeType" minOccurs="0"/>
            <xs:element name="IndustryType" type="CodeType" minOccurs="0"/>
            <xs:element name="Workplace" type="CodeType" minOccurs="0"/>
            <xs:element name="JobSector" type="CodeType" minOccurs="0"/>
            <xs:element name="MinimumYearsExperience" type="xs:integer" minOccurs="0"/>
            <xs:element name="Period" type="PeriodType" minOccurs="0"/>
            <xs:element name="WorkExperienceDescription" type="ExperienceDescriptionType"
                minOccurs="0"/>
            <xs:element name="AlternativeWorkExperience" type="AlternativeWorkExperienceType"
                minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="AlternativeWorkExperienceType">
        <xs:sequence>
            <xs:element name="ID" type="IdentifierType"/>
            <xs:element name="Requirement" type="CodeType" minOccurs="0"/>
            <xs:element name="PositionLevel" type="CodeType" minOccurs="0"/>
            <xs:element name="IndustryType" type="CodeType" minOccurs="0"/>
            <xs:element name="Workplace" type="CodeType" minOccurs="0"/>
            <xs:element name="JobSector" type="CodeType" minOccurs="0"/>
            <xs:element name="MinimumYearsExperience" type="xs:integer" minOccurs="0"/>
            <xs:element name="Period" type="PeriodType" minOccurs="0"/>
            <xs:element name="WorkExperienceDescription" type="ExperienceDescriptionType"
                minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SkillsType">
        <xs:sequence>
            <xs:element name="ID" type="IdentifierType"/>
            <xs:element name="Requirement" type="CodeType" minOccurs="0"/>
            <xs:element name="Type" type="CodeType" minOccurs="0"/>
            <xs:element name="VersionID" type="IdentifierType" minOccurs="0"/>
            <xs:element name="LastPractice" type="DateType" minOccurs="0"/>
            <xs:element name="MinimumLengthPractice" type="QuantityType" minOccurs="0"/>
            <xs:element name="SkillsReference" type="xs:boolean" minOccurs="0"/>
            <xs:element name="AlternativeSkills" type="AlternativeSkillsType" minOccurs="0"
                maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="AlternativeSkillsType">
        <xs:sequence>
            <xs:element name="ID" type="IdentifierType"/>
            <xs:element name="Requirement" type="CodeType" minOccurs="0"/>
            <xs:element name="Type" type="CodeType" minOccurs="0"/>
            <xs:element name="VersionID" type="IdentifierType" minOccurs="0"/>
            <xs:element name="LastPractice" type="DateType" minOccurs="0"/>
            <xs:element name="MinimumLengthPractice" type="QuantityType" minOccurs="0"/>
            <xs:element name="SkillsReference" type="xs:boolean" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ClearanceType">
        <xs:sequence>
            <xs:element name="ID" type="IdentifierType"/>
            <xs:element name="Requirement" type="CodeType" minOccurs="0"/>
            <xs:element name="Level" type="CodeType" minOccurs="0"/>
            <xs:element name="ExpirationDate" type="DateType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SenderPartyType">
        <xs:annotation>
            <xs:documentation> Modelled after UBL 2.1 cac:SupplierPartyType pattern. Represents the
                party sending the CV request. </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Party" type="PartyType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ReceiverPartyType">
        <xs:annotation>
            <xs:documentation> Modelled after UBL 2.1 cac:CustomerPartyType pattern. Represents the
                party receiving the CV request. </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Party" type="PartyType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PartyType">
        <xs:annotation>
            <xs:documentation> Modelled after UBL 2.1 cac:PartyType, but only elements needed for
                ehf-cv are included </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="EndpointID" type="IdentifierType" minOccurs="0"/>
            <xs:element name="PartyName" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Name" type="TextType"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="PostalAddress" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Country" minOccurs="0">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="IdentificationCode" type="CodeType"/>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="Contact" type="ContactType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ContactType">
        <xs:annotation>
            <xs:documentation> Modelled after UBL 2.1 cac:ContactType, Role is an ehf-cv specific
                element, else only elements needed for ehf-cv are included </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Name" type="TextType" minOccurs="0"/>
            <xs:element name="Role" type="CodeType" minOccurs="0"/>
            <xs:element name="Telephone" type="TextType" minOccurs="0"/>
            <xs:element name="ElectronicMail" type="TextType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PeriodType">
        <xs:annotation>
            <xs:documentation> Modelled after UBL 2.1 cac:PeriodType, only elements needed for
                ehf-cv are included </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="StartDate" type="DateType" minOccurs="0"/>
            <xs:element name="EndDate" type="DateType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="RelevantExperienceType">
        <xs:annotation>
            <xs:documentation> EHF CV Request-specific type with no UBL 2.1 equivalent. Expresses a
                requirement for relevant experience within a given occupation.
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Type" type="CodeType"/>
            <xs:element name="MinYear" type="xs:integer" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="RequiredTotalExperienceType">
        <xs:annotation>
            <xs:documentation> EHF CV Request-specific type with no UBL 2.1 equivalent. Expresses a
                required span of total experience. </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="MinimumYearsExperience" type="xs:integer" minOccurs="0"/>
            <xs:element name="MaximumYearsExperience" type="xs:integer" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ExperienceDescriptionType">
        <xs:annotation>
            <xs:documentation> EHF CV-specific type with no UBL 2.1 equivalent. UBL 2.1 has no
                aggregate type for describing work or project experience. The closest UBL elements
                are cbc:Percent (used for tax rates and discounts, not position percentage) and
                cbc:Description (generic text, less precise than Role and Activities). These do not
                provide meaningful alignment and the EHF CV-specific naming is retained for clarity.
                Used for both ExperienceDescription and WorkExperienceDescription.
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="PositionPercent" type="xs:integer" minOccurs="0"/>
            <xs:element name="Role" type="CodeType" minOccurs="0"/>
            <xs:element name="Activities" type="TextType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ExperienceValueType">
        <xs:sequence>
            <xs:element name="ProjectParticipation" type="QuantityType" minOccurs="0"/>
            <xs:element name="ProjectSize" type="QuantityType" minOccurs="0"/>
            <xs:element name="ProjectValue" type="AmountType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="QuantityType">
        <xs:annotation>
            <xs:documentation> Modelled after UBL 2.1 udt:QuantityType
                (UnqualifiedDataTypes-2.1.xsd, UN/CEFACT CCTS). </xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:decimal">
                <xs:attribute name="unitCode" type="xs:normalizedString"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="AmountType">
        <xs:annotation>
            <xs:documentation> Modelled after UBL 2.1 udt:AmountType (UnqualifiedDataTypes-2.1.xsd,
                UN/CEFACT CCTS) </xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:decimal">
                <xs:attribute name="currencyID" type="xs:normalizedString"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- Primitive typer -->

    <xs:complexType name="IdentifierType">
        <xs:annotation>
            <xs:documentation> Modelled after UBL 2.1 udt:IdentifierType
                (UnqualifiedDataTypes-2.1.xsd, UN/CEFACT CCTS). Used directly for all identifier
                elements (ID, CustomizationID, ProfileID etc.) without named subtypes, as the
                element name provides sufficient semantic context in EHF CV. Only the schemeID
                attribute is included; other UBL attributes (schemeName, schemeAgencyID, etc.) are
                omitted as they are not used in EHF CV. </xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:normalizedString">
                <xs:attribute name="schemeID" type="xs:normalizedString"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="TextType">
        <xs:annotation>
            <xs:documentation> Modelled after UBL 2.1 udt:TextType (UnqualifiedDataTypes-2.1.xsd,
                UN/CEFACT CCTS). Used directly for all text elements without named subtypes, as the
                element name provides sufficient semantic context in EHF CV. All attributes are
                omitted as they are not used in EHF CV. </xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:string"/>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="DateType">
        <xs:annotation>
            <xs:documentation> Modelled after UBL 2.1 udt:DateType (UnqualifiedDataTypes-2.1.xsd,
                UN/CEFACT CCTS). Used directly for all date elements without named subtypes, as the
                element name provides sufficient semantic context in EHF CV. </xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:date"/>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="TimeType">
        <xs:annotation>
            <xs:documentation> Modelled after UBL 2.1 udt:TimeType (UnqualifiedDataTypes-2.1.xsd,
                UN/CEFACT CCTS). Used directly for all time elements without named subtypes, as the
                element name provides sufficient semantic context in EHF CV. </xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:time"/>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="CodeType">
        <xs:annotation>
            <xs:documentation> Modelled after UBL 2.1 udt:CodeType (UnqualifiedDataTypes-2.1.xsd,
                UN/CEFACT CCTS). Used directly for all code elements without named subtypes, as the
                element name provides sufficient semantic context in EHF CV. </xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:normalizedString"> </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

</xs:schema>
