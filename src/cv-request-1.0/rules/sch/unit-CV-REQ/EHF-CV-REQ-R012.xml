<?xml version="1.0" encoding="UTF-8"?>
<testSet xmlns="http://difi.no/xsd/vefa/validator/1.0"
	configuration="ehf-cv-request-1.0">
	<assert>
		<description>Verify minimum length of practice</description>
		<scope>EHF-CV-REQ-R012</scope>
	</assert>

	<test id="1">
		<assert>
			<success>EHF-CV-REQ-R012</success>
		</assert>
		<CVRequest xmlns="urn:fdc:anskaffelser.no:2019:ehf:schema:CVRequest-1">

      <Skills>
        <MinimumLengthPractice>8</MinimumLengthPractice>
      </Skills>

		</CVRequest>
	</test>

  <test id="2">
    <assert>
      <success>EHF-CV-REQ-R012</success>
    </assert>
    <CVRequest xmlns="urn:fdc:anskaffelser.no:2019:ehf:schema:CVRequest-1">

      <Skills>
        <MinimumLengthPractice>0</MinimumLengthPractice>
      </Skills>

    </CVRequest>
  </test>

  <test id="3">
    <assert>
      <success>EHF-CV-REQ-R012</success>
    </assert>
    <CVRequest xmlns="urn:fdc:anskaffelser.no:2019:ehf:schema:CVRequest-1">

      <AlternativeSkills>
        <MinimumLengthPractice>12</MinimumLengthPractice>
      </AlternativeSkills>

    </CVRequest>
  </test>

  <test id="4">
    <assert>
      <success>EHF-CV-REQ-R012</success>
    </assert>
    <CVRequest xmlns="urn:fdc:anskaffelser.no:2019:ehf:schema:CVRequest-1">

      <Skills>
        <Type>java</Type>
      </Skills>

    </CVRequest>
  </test>

  <test id="5">
    <assert>
      <error>EHF-CV-REQ-R012</error>
    </assert>
    <CVRequest xmlns="urn:fdc:anskaffelser.no:2019:ehf:schema:CVRequest-1">

      <Skills>
        <MinimumLengthPractice>-5</MinimumLengthPractice>
      </Skills>

    </CVRequest>
  </test>

  <test id="6">
    <assert>
      <error>EHF-CV-REQ-R012</error>
    </assert>
    <CVRequest xmlns="urn:fdc:anskaffelser.no:2019:ehf:schema:CVRequest-1">

      <AlternativeSkills>
        <MinimumLengthPractice>-1</MinimumLengthPractice>
      </AlternativeSkills>

    </CVRequest>
  </test>

</testSet>
